# ==========================================================================
# IndustrialLink - Mẫu biến môi trường.
# Copy file này thành .env rồi chỉnh giá trị. KHÔNG commit file .env.
# ==========================================================================

# --- Chung ---
NODE_ENV=development

# --- Backend API (apps/api) ---
API_PORT=3001
# Đường dẫn web frontend, dùng cho cấu hình CORS.
WEB_ORIGIN=http://localhost:3000

# --- Database (PostgreSQL + pgvector) ---
# Khớp với dịch vụ postgres trong infra/docker-compose.yml.
DATABASE_URL=postgresql://industriallink:industriallink@localhost:5432/industriallink?schema=public

# --- Redis (cache + hàng đợi BullMQ) ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# --- Object Storage (MinIO / S3-compatible) ---
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=industriallink
S3_SECRET_KEY=industriallink
S3_BUCKET=industriallink-resumes
# true khi dùng MinIO (path-style). Với AWS S3 thật đặt false.
S3_FORCE_PATH_STYLE=true

# --- Bảo mật / JWT ---
# Bắt buộc đổi ở môi trường thật. Sinh chuỗi ngẫu nhiên đủ dài.
JWT_ACCESS_SECRET=dev-access-secret-change-me
JWT_REFRESH_SECRET=dev-refresh-secret-change-me
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=1209600

# --- AI Gateway ---
# Provider: mock (mặc định, không cần key) | openai | anthropic | gemini
# Thiếu API key khi chọn provider thật → tự fallback mock + log cảnh báo.
AI_PROVIDER=mock
# Số chiều vector embedding (mock / Anthropic / Gemini local dùng đúng số chiều này).
AI_EMBEDDING_DIM=768
# OpenAI (parse CV + embedding thật khi AI_PROVIDER=openai)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# Anthropic (parse CV; embedding hiện deterministic local)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-latest
# Gemini (parse CV; embedding hiện deterministic local)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# --- Email (mời phỏng vấn, OTP sau này) ---
# Provider: mock (log console) | smtp (Mailpit/Gmail…) | resend
# Local: bật Mailpit (docker) rồi đặt EMAIL_PROVIDER=smtp
EMAIL_PROVIDER=mock
EMAIL_FROM=IndustrialLink <noreply@industriallink.local>
# SMTP — mặc định khớp Mailpit (infra): host localhost, port 1025, không auth
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# Resend (production): https://resend.com — cần domain verified
RESEND_API_KEY=

# --- OpenTelemetry (traces → Jaeger, metrics → Prometheus) ---
OTEL_ENABLED=true
OTEL_SERVICE_NAME=industriallink-api
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_METRICS_PORT=9464

# --- OpenSearch (AI Search full-text; tắt = chỉ Postgres/pgvector) ---
OPENSEARCH_ENABLED=true
OPENSEARCH_NODE=http://localhost:9200

# --- Event Bus (memory | rabbitmq; lỗi kết nối → fallback memory) ---
EVENT_BUS_PROVIDER=rabbitmq
RABBITMQ_URL=amqp://guest:guest@localhost:5672

# --- Frontend (apps/web) ---
NEXT_PUBLIC_API_URL=http://localhost:3001
