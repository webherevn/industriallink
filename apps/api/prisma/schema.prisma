  @@index([tenantId, isDeleted])
  @@index([sortOrder])
  @@map("cms_category")
  @@schema("cms")
}

model CmsPost {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId       String    @default("default") @map("tenant_id")
  /// post | page
  type           String
  title          String
  slug           String
  excerpt        String?
  bodyHtml       String    @default("") @map("body_html")
  /// draft | published | archived
  status         String    @default("draft")
  categoryId     String?   @map("category_id") @db.Uuid
  publishedAt    DateTime? @map("published_at")
  /// User.id của tài khoản đăng bài (kiểu WP author)
  authorId       String    @map("author_id") @db.Uuid
  /// Snapshot hiển thị — ưu tiên lấy từ CmsAuthorProfile khi đọc
  authorName     String?   @map("author_name")
  authorTitle    String?   @map("author_title")
  authorBio      String?   @map("author_bio")
  coverImageUrl  String?   @map("cover_image_url")
  seoTitle       String?   @map("seo_title")
  seoDescription String?   @map("seo_description")
  /// Focus keyphrase (Yoast / Rank Math style)
  focusKeyword   String?   @map("focus_keyword")
  canonicalPath  String?   @map("canonical_path")
  ogTitle        String?   @map("og_title")
  ogDescription  String?   @map("og_description")
  ogImageUrl     String?   @map("og_image_url")
  /// index | noindex
  robotsIndex    Boolean   @default(true) @map("robots_index")
  /// follow | nofollow
  robotsFollow   Boolean   @default(true) @map("robots_follow")
  /// max-image-preview:large (Google Discover)
  robotsMaxImagePreview Boolean @default(true) @map("robots_max_image_preview")
  /// Legacy combined robots string (đồng bộ từ robotsIndex/Follow)
  robots         String    @default("index,follow")
  /// FAQ Schema: [{ "question": "...", "answer": "..." }]
  faqJson        Json?     @map("faq_json")
  /// JSON-LD tùy biến. Null = schema Article/WebPage mặc định.
  customSchema   String?   @map("custom_schema") @db.Text

  createdAt DateTime  @default(now()) @map("created_at")
  createdBy String?   @map("created_by") @db.Uuid
  updatedAt DateTime  @updatedAt @map("updated_at")
  updatedBy String?   @map("updated_by") @db.Uuid
  deletedAt DateTime? @map("deleted_at")
  deletedBy String?   @map("deleted_by") @db.Uuid
  isDeleted Boolean   @default(false) @map("is_deleted")
  version   Int       @default(1)

  category CmsCategory? @relation(fields: [categoryId], references: [id])

  @@unique([type, slug])
  @@index([tenantId, type, status, publishedAt])
  @@index([categoryId])
  @@index([authorId])
  @@index([isDeleted])
  @@map("cms_post")
  @@schema("cms")
}

