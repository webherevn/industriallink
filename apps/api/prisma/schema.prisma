  signups     CrmReferralSignup[]
  periods     CrmCommissionPeriod[]
  wallet      CrmCommissionWallet?

  @@map("crm_partner")
  @@schema("crm")
}

/// Nhà tuyển dụng đăng ký khi cookie giới thiệu còn hạn. Chưa phải hoa hồng.
model CrmReferralSignup {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  partnerId    String   @map("partner_id") @db.Uuid
  userId       String   @unique @map("user_id") @db.Uuid
  displayName  String   @map("display_name")
  capturedAt   DateTime @map("captured_at")
  registeredAt DateTime @map("registered_at")
  createdAt    DateTime @default(now()) @map("created_at")

  partner CrmPartner @relation(fields: [partnerId], references: [id])

  @@index([partnerId, registeredAt])
  @@map("crm_referral_signup")
  @@schema("crm")
}

/// Khóa mã số thuế cho một cộng tác viên. Không gán gói, không tính hoa hồng.
model CrmPartnerClaim {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  partnerId    String   @map("partner_id") @db.Uuid
  companyName  String   @map("company_name")
  taxCode      String   @unique @map("tax_code")
  contactPhone String   @map("contact_phone")
  createdAt    DateTime @default(now()) @map("created_at")

  partner CrmPartner @relation(fields: [partnerId], references: [id])

  @@index([partnerId])
  @@map("crm_partner_claim")
  @@schema("crm")
}

/// Ngày trong tháng kế toán ghi đã chi. Không tự trừ ví và không chuyển khoản.
model CrmCommissionPayoutSetting {
  id              String   @id @default("default")
  payoutDay       Int      @default(10) @map("payout_day")
  /// YYYY-MM-DD giờ Việt Nam của lần nhắc ngày chi gần nhất.
  remindedOn      String?  @map("reminded_on")
  updatedByUserId String?  @map("updated_by_user_id") @db.Uuid
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@map("crm_commission_payout_setting")
  @@schema("crm")
}

/// Thuế suất để trống đến khi SuperAdmin nhập. Không đổi giá niêm yết.
model CrmVatSetting {
  id              String   @id @default("default")
  percent         Int?
  updatedByUserId String?  @map("updated_by_user_id") @db.Uuid
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@map("crm_vat_setting")
  @@schema("crm")
}

/// Một tỷ lệ cho toàn bộ cộng tác viên. Không tạo ví và không có lệnh chi.
model CrmCommissionSetting {
  id              String   @id @default("default")
  percent         Int
  updatedByUserId String   @map("updated_by_user_id") @db.Uuid
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@map("crm_commission_setting")
  @@schema("crm")
}

/// Ghi khi đơn gói đã thanh toán online. Không tạo từ bước Đã chốt. Chưa chi.
model CrmCommissionEntry {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  partnerId       String   @map("partner_id") @db.Uuid
  companyId       String   @map("company_id") @db.Uuid
  companyName     String   @map("company_name")
  billingOrderId  String   @unique @map("billing_order_id") @db.Uuid
  /// platform | sourcing. Không gồm nạp Credit.
  orderKind       String   @map("order_kind")
  planCode        String?  @map("plan_code")
  planName        String?  @map("plan_name")
  paidAmountVnd   BigInt   @map("paid_amount_vnd")
  percent         Int
  commissionVnd   BigInt   @map("commission_vnd")
  /// Chờ đối soát cho đến khi gắn vào một kỳ chốt. Chưa phải lệnh chi.
  status          String   @default("pending_reconcile")
  paidAt          DateTime @map("paid_at")
  createdAt       DateTime @default(now()) @map("created_at")
  periodId        String?  @map("period_id") @db.Uuid

  partner      CrmPartner              @relation(fields: [partnerId], references: [id])
  billingOrder BillingOrder            @relation(fields: [billingOrderId], references: [id])
  period       CrmCommissionPeriod?    @relation(fields: [periodId], references: [id])
  walletTxn    CrmCommissionWalletTxn?

  @@index([partnerId, paidAt])
  @@index([companyId])
  @@index([periodId])
  @@map("crm_commission_entry")
  @@schema("crm")
}

/// Một kỳ một cộng tác viên một tháng. Chờ SuperAdmin cho phép chi. Số đã nằm trong ví.
model CrmCommissionPeriod {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  partnerId      String   @map("partner_id") @db.Uuid
  /// Tháng dương lịch giờ Việt Nam, dạng YYYY-MM.
  periodMonth    String   @map("period_month")
  paidAmountVnd  BigInt   @map("paid_amount_vnd")
  commissionVnd  BigInt   @map("commission_vnd")
  entryCount     Int      @map("entry_count")
  /// closed = chờ cho phép chi. payable = đã chuyển kế toán. paid = đã chi, ví đã trừ.
  status            String    @default("closed")
  /// Null khi hệ thống tự chốt sau ngày cuối tháng.
  closedByUserId    String?   @map("closed_by_user_id") @db.Uuid
  closedAt          DateTime  @default(now()) @map("closed_at")
  approvedByUserId  String?   @map("approved_by_user_id") @db.Uuid
  approvedAt        DateTime? @map("approved_at")
  paidByUserId      String?   @map("paid_by_user_id") @db.Uuid
  paidAt            DateTime? @map("paid_at")

  partner  CrmPartner              @relation(fields: [partnerId], references: [id])
  entries  CrmCommissionEntry[]
  debitTxn CrmCommissionWalletTxn?

  @@unique([partnerId, periodMonth])
  @@index([periodMonth])
  @@map("crm_commission_period")
  @@schema("crm")
}

/// Số dư hoa hồng trên inlink. Tách khỏi Credit của nhà tuyển dụng.
model CrmCommissionWallet {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  partnerId String   @unique @map("partner_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  partner CrmPartner                @relation(fields: [partnerId], references: [id])
  txns    CrmCommissionWalletTxn[]

  @@map("crm_commission_wallet")
  @@schema("crm")
}

/// Dòng cộng theo khoản hoa hồng, hoặc dòng trừ khi kế toán ghi đã chi một kỳ.
model CrmCommissionWalletTxn {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  walletId          String   @map("wallet_id") @db.Uuid
  partnerId         String   @map("partner_id") @db.Uuid
  commissionEntryId String?  @unique @map("commission_entry_id") @db.Uuid
  periodId          String?  @unique @map("period_id") @db.Uuid
  amountVnd         BigInt   @map("amount_vnd")
  /// credit | debit. Số tiền luôn dương.
  kind              String   @default("credit")
  createdAt         DateTime @default(now()) @map("created_at")

  wallet CrmCommissionWallet  @relation(fields: [walletId], references: [id])
  entry  CrmCommissionEntry?  @relation(fields: [commissionEntryId], references: [id])
  period CrmCommissionPeriod? @relation(fields: [periodId], references: [id])

  @@index([partnerId])
  @@map("crm_commission_wallet_txn")
  @@schema("crm")
}

/// Số hóa đơn đã xuất cho một đơn gói đã thanh toán. Không tính VAT và không theo dõi công nợ.
model CrmOrderInvoice {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  billingOrderId String   @unique @map("billing_order_id") @db.Uuid
  companyId      String   @map("company_id") @db.Uuid
  companyName    String   @map("company_name")
  /// platform | sourcing. Không gồm nạp Credit.
  orderKind      String   @map("order_kind")
  planCode       String?  @map("plan_code")
  planName       String?  @map("plan_name")
  paidAmountVnd  BigInt   @map("paid_amount_vnd")
  paidAt         DateTime @map("paid_at")
  invoiceNumber  String   @unique @map("invoice_number")
  issuedByUserId String   @map("issued_by_user_id") @db.Uuid
  issuedAt       DateTime @default(now()) @map("issued_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  billingOrder BillingOrder @relation(fields: [billingOrderId], references: [id])

  @@index([companyId])
  @@map("crm_order_invoice")
  @@schema("crm")
}

model CrmLead {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  leadCode     String   @unique @map("lead_code")
  companyName  String   @map("company_name")
  taxCode      String?  @map("tax_code")
  contactName  String   @map("contact_name")
  contactPhone String   @map("contact_phone")
  contactEmail String?  @map("contact_email")
  industry     String?
  /// Công ty đã có trên inlink, nếu lead đã khớp.
  companyId    String?  @map("company_id") @db.Uuid
  /// open | converted | unqualified
  status       String   @default("open")
  /// web | zalo | event | partner | unknown. unknown chỉ cho lead tạo trước khi có nguồn.
  source       String   @default("unknown")
  /// Cộng tác viên giới thiệu, chỉ khi source = partner.
  partnerId    String?  @map("partner_id") @db.Uuid
  ownerUserId  String   @map("owner_user_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  deals      CrmDeal[]
  activities CrmActivity[]
  partner    CrmPartner? @relation(fields: [partnerId], references: [id])

  @@index([taxCode])
  @@index([contactPhone])
  @@index([ownerUserId, status])
  @@index([partnerId])
  @@map("crm_lead")
  @@schema("crm")
}

model CrmDeal {
  id          String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  dealCode    String  @unique @map("deal_code")
  title       String
  leadId      String  @map("lead_id") @db.Uuid
  companyId   String? @map("company_id") @db.Uuid
  pipelineId  String  @map("pipeline_id") @db.Uuid
  stageId     String  @map("stage_id") @db.Uuid
  /// platform | sourcing. Trỏ SKU SuperAdmin, không tự kích hoạt.
  planKind    String? @map("plan_kind")
  planCode    String? @map("plan_code")
  /// Giá niêm yết chưa VAT, snapshot lúc tạo. Không dùng để cộng Credit.
  listPriceVnd BigInt? @map("list_price_vnd")
  /// Không dùng. Thanh toán nằm ở cổng của nhà tuyển dụng.
  billingOrderId String? @map("billing_order_id") @db.Uuid
  /// CRM không gán gói. Cột này luôn not_provisioned.
  provisionState String @default("not_provisioned") @map("provision_state")
  /// none | issued. Ghi số đã xuất, không phải công nợ.
  invoiceStatus String @default("none") @map("invoice_status")
  invoiceNumber String? @map("invoice_number")
  invoiceIssuedAt DateTime? @map("invoice_issued_at")
  ownerUserId String   @map("owner_user_id") @db.Uuid
  wonAt       DateTime? @map("won_at")
  lostAt      DateTime? @map("lost_at")
  lostReason  String?   @map("lost_reason")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  lead     CrmLead     @relation(fields: [leadId], references: [id])
  pipeline CrmPipeline @relation(fields: [pipelineId], references: [id])
  stage    CrmStage    @relation(fields: [stageId], references: [id])
  activities CrmActivity[]

  @@index([ownerUserId, stageId])
  @@index([companyId])
  @@map("crm_deal")
  @@schema("crm")
}

model CrmActivity {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  leadId          String?  @map("lead_id") @db.Uuid
  dealId          String?  @map("deal_id") @db.Uuid
  activityType    String   @map("activity_type")
  summary         String
  createdByUserId String   @map("created_by_user_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at")
  /// Có giá trị khi dòng này do đơn đã thanh toán ghi. Mỗi đơn một dòng.
  billingOrderId  String?  @unique @map("billing_order_id") @db.Uuid

  lead         CrmLead?      @relation(fields: [leadId], references: [id])
  deal         CrmDeal?      @relation(fields: [dealId], references: [id])
  billingOrder BillingOrder? @relation(fields: [billingOrderId], references: [id])

  @@index([leadId, createdAt])
  @@map("crm_activity")
  @@schema("crm")
}

