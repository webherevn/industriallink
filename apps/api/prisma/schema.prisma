  @@schema("cms")
}

/// Menu điều hướng trang chủ (kiểu WP Appearance → Menus), không phải nav ứng viên/NTD.
model CmsMenu {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId String @default("default") @map("tenant_id")
  /// primary | footer
  location String
  name     String

  createdAt DateTime @default(now()) @map("created_at")
  createdBy String?  @map("created_by") @db.Uuid
  updatedAt DateTime @updatedAt @map("updated_at")
  updatedBy String?  @map("updated_by") @db.Uuid

  items CmsMenuItem[]

  @@unique([tenantId, location])
  @@map("cms_menu")
  @@schema("cms")
}

model CmsMenuItem {
  id           String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  menuId       String  @map("menu_id") @db.Uuid
  parentId     String? @map("parent_id") @db.Uuid
  label        String
  url          String
  sortOrder    Int     @default(0) @map("sort_order")
  openInNewTab Boolean @default(false) @map("open_in_new_tab")
  /// custom | page | post
  objectType   String  @default("custom") @map("object_type")
  objectId     String? @map("object_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  menu     CmsMenu      @relation(fields: [menuId], references: [id], onDelete: Cascade)
  parent   CmsMenuItem? @relation("CmsMenuItemTree", fields: [parentId], references: [id], onDelete: Cascade)
  children CmsMenuItem[] @relation("CmsMenuItemTree")

  @@index([menuId, sortOrder])
  @@index([parentId])
  @@map("cms_menu_item")
  @@schema("cms")
}

/// Chân trang WP-style: Footer 1 / Footer 2 (mỗi cái 4 cột HTML) + copyright.
model CmsFooterSettings {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId String @unique @default("default") @map("tenant_id")

  footer1Enabled Boolean @default(true) @map("footer1_enabled")
  /// JSON: string[4] — HTML từng cột (rỗng = ẩn cột)
  footer1Columns Json    @default("[]") @map("footer1_columns")

  footer2Enabled Boolean @default(true) @map("footer2_enabled")
  footer2Columns Json    @default("[]") @map("footer2_columns")

  /// Hàng dưới cùng, ví dụ: ©2026 Inlink Vietnam JSC. All rights reserved.
  copyrightText String @default("©2026 Inlink Vietnam JSC. All rights reserved.") @map("copyright_text")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  updatedBy String?  @map("updated_by") @db.Uuid

  @@map("cms_footer_settings")
  @@schema("cms")
}

/// SEO & nội dung hero trang chủ (/).
model CmsHomepageSettings {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId String @unique @default("default") @map("tenant_id")

  /// H1 hiển thị trên hero
  heading       String  @default("Tìm đúng cơ hội trong ngành công nghiệp")
  /// Đoạn trong H1 tô màu accent (phải nằm trong heading)
  headingAccent String? @map("heading_accent")
  /// Đoạn mô tả dưới H1
  subtitle      String? @default("Hàng nghìn cơ hội việc làm từ các doanh nghiệp uy tín trong lĩnh vực kỹ thuật, sản xuất, vận hành và kinh doanh B2B.")

  seoTitle       String? @map("seo_title")
  seoDescription String? @map("seo_description")
  focusKeyword   String? @map("focus_keyword")
  canonicalPath  String? @default("/") @map("canonical_path")
  ogTitle        String? @map("og_title")
  ogDescription  String? @map("og_description")
  ogImageUrl     String? @map("og_image_url")
  robotsIndex    Boolean @default(true) @map("robots_index")
  robotsFollow   Boolean @default(true) @map("robots_follow")
  robotsMaxImagePreview Boolean @default(true) @map("robots_max_image_preview")
  /// JSON-LD tùy biến. Null = không xuất schema tùy biến.
  customSchema   String? @map("custom_schema") @db.Text

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  updatedBy String?  @map("updated_by") @db.Uuid

  @@map("cms_homepage_settings")
  @@schema("cms")
}

/// robots.txt do SuperAdmin chỉnh (kiểu RankMath). null content = dùng mặc định hệ thống.
model CmsRobotsSettings {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId String @unique @default("default") @map("tenant_id")

  /// Nội dung robots.txt đầy đủ (plain text)
  content String @map("content") @db.Text

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  updatedBy String?  @map("updated_by") @db.Uuid

  @@map("cms_robots_settings")
  @@schema("cms")
}

/// Insert Headers and Footers (WP-style) — mã HTML/JS cho SEO (GA, GTM, meta…).
model CmsSiteCodeSettings {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId String @unique @default("default") @map("tenant_id")

  headerEnabled Boolean @default(true) @map("header_enabled")
  /// Mã chèn trong <head> (script, meta, link…)
  headerCode    String  @default("") @map("header_code") @db.Text

  footerEnabled Boolean @default(true) @map("footer_enabled")
  /// Mã chèn trước </body>
  footerCode    String  @default("") @map("footer_code") @db.Text

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  updatedBy String?  @map("updated_by") @db.Uuid

  @@map("cms_site_code_settings")
  @@schema("cms")
}

// =========================================================================
// BILLING
// =========================================================================
// Cấu hình giá & quota cho nền tảng tuyển dụng + dịch vụ Săn nhân sự.
// Mọi giá trị (giá, quota, top-up, phí dịch vụ) đều lưu DB và chỉnh được
// từ /admin/billing (SuperAdmin) — KHÔNG hardcode trong code.

/// Cấu hình gói nền tảng (Tầng 1).
/// 5 gói: KHAM_PHA (0đ) | TIN_DANG | TIN_DANG_PLUS | DOANH_NGHIEP | ENTERPRISE.
model BillingPlatformPlan {
  id          String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  /// Mã gói nội bộ (enum-like, unique, snake_case).
  code        String  @unique
  /// Tên hiển thị tiếng Việt.
  name        String
  /// Mô tả ngắn hiển thị trên UI bảng giá.
  description String?

  /// Giá gói tính bằng VND (integer). KHAM_PHA = 0.
  priceVnd    BigInt  @map("price_vnd")
  /// Đơn vị thời hạn: "per_jd" (giá theo JD) | "per_month" (đăng ký tháng).
  billingUnit String  @map("billing_unit")
  /// Số ngày hiệu lực (null = không giới hạn cho gói tháng). Tài liệu V1: 7-30 ngày.
  durationDays Int?  @map("duration_days")
  /// Số JD được đăng (null = unlimited cho DOANH_NGHIEP/ENTERPRISE).
  jobPostQuota Int?  @map("job_post_quota")
  /// Số lượt mở hồ sơ (Credit quota). 0 = không cấp, null = quota riêng theo hợp đồng.
  creditQuota Int?  @map("credit_quota")

  /// Thứ tự hiển thị trên trang bảng giá (1 = đầu).
  sortOrder   Int     @default(0) @map("sort_order")
  /// Có đang bán hay tạm ẩn.
  isActive    Boolean @default(true) @map("is_active")
  /// Đánh dấu gói nổi bật (highlight trên UI).
  isFeatured  Boolean @default(false) @map("is_featured")

  /// JSON danh sách quyền kèm theo (vd: ["view_applicant","download_cv","export_report"]).
  features    Json    @default("[]")

  createdAt DateTime @default(now()) @map("created_at")
  createdBy String?  @map("created_by") @db.Uuid
  updatedAt DateTime @updatedAt @map("updated_at")
  updatedBy String?  @map("updated_by") @db.Uuid

  actionCosts     BillingPlanActionCost[]
  companyPlans    BillingCompanyPlan[]

  @@map("billing_platform_plan")
  @@schema("billing")
}

/// Cost-per-action riêng từng gói nền tảng.
/// SuperAdmin chỉnh từ UI; khi công ty được gán gói này thì trừ Credit theo bảng này.
/// Action không có row → fallback BillingCreditPolicy (global).
model BillingPlanActionCost {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  planId    String   @map("plan_id") @db.Uuid
  /// 'view_profile' | 'reopen_profile' | 'view_applicant' | 'contact_potential' | 'contact_applicant' | 'view_match_summary'
  action    String
  cost      Int      @default(1)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  plan BillingPlatformPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@unique([planId, action])
  @@index([planId, isActive])
  @@map("billing_plan_action_cost")
  @@schema("billing")
}

/// Gói nền tảng đang gán cho công ty (1 công ty = 1 gói active).
/// Dùng để resolve cost-per-action khi trừ Credit; chưa có gán → fallback policy global.
model BillingCompanyPlan {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId String    @unique @map("company_id") @db.Uuid
  planId    String    @map("plan_id") @db.Uuid
  startsAt  DateTime  @default(now()) @map("starts_at")
  endsAt    DateTime? @map("ends_at")
  isActive  Boolean   @default(true) @map("is_active")
  note      String?
  createdAt DateTime  @default(now()) @map("created_at")
  createdBy String?   @map("created_by") @db.Uuid
  updatedAt DateTime  @updatedAt @map("updated_at")
  updatedBy String?   @map("updated_by") @db.Uuid

  plan BillingPlatformPlan @relation(fields: [planId], references: [id], onDelete: Restrict)

  @@index([planId, isActive])
  @@map("billing_company_plan")
  @@schema("billing")
}

/// Cấu hình gói dịch vụ Săn nhân sự (Tầng 2).
/// 3 gói: SAN_CO_BAN | SAN_TIEU_CHUAN | SAN_CHUYEN_SAU.
model BillingSourcingPlan {
  id          String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  code        String  @unique
  name        String
  description String?

  /// Phí dịch vụ Săn (VND integer). KHÔNG bao gồm Credit — Credit tính riêng theo nguyên tắc V1.
  feeVnd      BigInt  @map("fee_vnd")
  /// Số vị trí được Săn tối đa trong 1 gói (1 cho SAN_CO_BAN theo tài liệu V1).
  positionQuota Int? @map("position_quota")
  /// Số đợt tìm kiếm tối đa.
  searchRoundQuota Int? @map("search_round_quota")
  /// Số shortlist tối đa (null = tùy báo giá).
  shortlistQuota Int? @map("shortlist_quota")
  /// Số lần điều chỉnh tối đa (SAN_CO_BAN: 1 theo V1).
  revisionQuota Int? @map("revision_quota")

  /// Phạm vi dịch vụ dạng JSON (vd: ["ai_match","filter","shortlist","strengths_gaps","priority","outreach","follow_up","replacement"]).
  /// Mapping đến 8 hàng trong bảng XI tài liệu.
  serviceScope Json  @default("[]") @map("service_scope")

  sortOrder Int     @default(0) @map("sort_order")
  isActive  Boolean @default(true) @map("is_active")
  isFeatured Boolean @default(false) @map("is_featured")

  createdAt DateTime @default(now()) @map("created_at")
  createdBy String?  @map("created_by") @db.Uuid
  updatedAt DateTime @updatedAt @map("updated_at")
  updatedBy String?  @map("updated_by") @db.Uuid

  companyAssignments BillingCompanySourcingPlan[]

  @@map("billing_sourcing_plan")
  @@schema("billing")
}

/// Gói Săn đang gán cho công ty (1 công ty = 1 gói Săn).
/// Quota đọc live từ BillingSourcingPlan SuperAdmin; used* đếm lượt đã dùng.
model BillingCompanySourcingPlan {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId String    @unique @map("company_id") @db.Uuid
  planId    String    @map("plan_id") @db.Uuid
  startsAt  DateTime  @default(now()) @map("starts_at")
  endsAt    DateTime? @map("ends_at")
  isActive  Boolean   @default(true) @map("is_active")
  note      String?

  positionsUsed    Int @default(0) @map("positions_used")
  searchRoundsUsed Int @default(0) @map("search_rounds_used")
  shortlistsUsed   Int @default(0) @map("shortlists_used")
  revisionsUsed    Int @default(0) @map("revisions_used")

  createdAt DateTime @default(now()) @map("created_at")
  createdBy String?  @map("created_by") @db.Uuid
  updatedAt DateTime @updatedAt @map("updated_at")
  updatedBy String?  @map("updated_by") @db.Uuid

  plan         BillingSourcingPlan         @relation(fields: [planId], references: [id], onDelete: Restrict)
  engagements  BillingSourcingEngagement[]
  usages       BillingSourcingUsage[]

  @@index([planId, isActive])
  @@map("billing_company_sourcing_plan")
  @@schema("billing")
}

/// Một vị trí Săn đã mở trong gói đang gán (trừ 1 positionQuota).
model BillingSourcingEngagement {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId    String   @map("company_id") @db.Uuid
  assignmentId String   @map("assignment_id") @db.Uuid
  jobId        String?  @map("job_id") @db.Uuid
  title        String
  /// 'open' | 'in_progress' | 'shortlisted' | 'closed'
  status       String   @default("open")
  createdAt    DateTime @default(now()) @map("created_at")
  createdBy    String?  @map("created_by") @db.Uuid
  updatedAt    DateTime @updatedAt @map("updated_at")

  assignment BillingCompanySourcingPlan @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  usages     BillingSourcingUsage[]

  @@index([companyId, createdAt])
  @@index([assignmentId])
  @@map("billing_sourcing_engagement")
  @@schema("billing")
}

/// Ledger trừ hạn mức Săn (vị trí / đợt tìm / shortlist / điều chỉnh).
model BillingSourcingUsage {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId    String   @map("company_id") @db.Uuid
  assignmentId String   @map("assignment_id") @db.Uuid
  engagementId String?  @map("engagement_id") @db.Uuid
  /// 'position' | 'search_round' | 'shortlist' | 'revision'
  kind         String
  jobId        String?  @map("job_id") @db.Uuid
  note         String?
  createdAt    DateTime @default(now()) @map("created_at")
  createdBy    String?  @map("created_by") @db.Uuid

  assignment BillingCompanySourcingPlan  @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  engagement BillingSourcingEngagement?  @relation(fields: [engagementId], references: [id], onDelete: SetNull)

  @@index([companyId, createdAt])
  @@index([assignmentId, kind])
  @@map("billing_sourcing_usage")
  @@schema("billing")
}

/// Cấu hình gói Top-up Credit.
/// Theo V1: 3 mức (20/50/100 lượt), giảm đơn giá theo số lượng.
model BillingCreditTopup {
  id          String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  /// Tên gói top-up hiển thị (vd: "20 lượt", "50 lượt", "100 lượt").
  name        String
  /// Số Credit trong gói.
  creditCount Int     @map("credit_count")
  /// Giá bán gói (VND integer).
  priceVnd    BigInt  @map("price_vnd")
  /// Đơn giá 1 lượt = priceVnd / creditCount. Lưu sẵn để UI hiển thị & sort nhanh.
  unitPriceVnd BigInt @map("unit_price_vnd")

  /// Mô tả/badge (vd: "Tiết kiệm 12%", "Phổ biến nhất").
  badge       String?
  sortOrder   Int     @default(0) @map("sort_order")
  isActive    Boolean @default(true) @map("is_active")
  isFeatured  Boolean @default(false) @map("is_featured")

  createdAt DateTime @default(now()) @map("created_at")
  createdBy String?  @map("created_by") @db.Uuid
  updatedAt DateTime @updatedAt @map("updated_at")
  updatedBy String?  @map("updated_by") @db.Uuid

  @@map("billing_credit_topup")
  @@schema("billing")
}

/// Cấu hình quy tắc trừ Credit (V1).
/// Bảng single-row, scope="default" — dễ chỉnh từ UI không cần đụng code.
model BillingCreditPolicy {
  id          String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  scope       String  @unique @default("default")

  /// 1 hồ sơ tiềm năng = ? Credit (V1 = 1).
  costPerProfile Int @default(1) @map("cost_per_profile")
  /// Mở lại hồ sơ đã mở trong cùng tài khoản = ? Credit (V1 = 0).
  costPerReopen Int @default(0) @map("cost_per_reopen")
  /// Xem ứng viên đã ứng tuyển (chủ động) = ? Credit (V1 = 0).
  costPerApplicant Int @default(0) @map("cost_per_applicant")
  /// Liên hệ ứng viên tiềm năng = ? Credit thêm (V1 = 0, đã tính khi mở hồ sơ).
  costPerContactPotential Int @default(0) @map("cost_per_contact_potential")
  /// Liên hệ ứng viên đã ứng tuyển = ? Credit (V1 = 0).
  costPerContactApplicant Int @default(0) @map("cost_per_contact_applicant")

  /// Xem tổng số Matching / phân bố % = ? Credit (V1 = 0, luôn miễn phí theo nguyên tắc #4).
  costPerMatchSummary Int @default(0) @map("cost_per_match_summary")

  /// Có cho phép mua Credit tự động (auto-charge) hay không (V1 = false theo nguyên tắc #8).
  allowAutoPurchase Boolean @default(false) @map("allow_auto_purchase")
  /// Ngân sách tối đa mặc định cho mỗi tài khoản (VND, null = không giới hạn).
  defaultBudgetVnd BigInt? @map("default_budget_vnd")
  /// Có cảnh báo khi quota dưới % ngưỡng (vd: 20%).
  warnWhenBelowPercent Int  @default(20) @map("warn_when_below_percent")
  /// Có cho phép vượt ngân sách khi mua thêm hay không (V1 = false).
  allowBudgetOverspend Boolean @default(false) @map("allow_budget_overspend")
  /// Credit có hết hạn khi tài khoản hết hoạt động không (V1 = false, đề xuất pháp lý).
  expireWhenInactive Boolean @default(false) @map("expire_when_inactive")
  /// Số ngày không hoạt động trước khi coi là "inactive" (chỉ dùng nếu expireWhenInactive = true).
  inactiveDays Int? @map("inactive_days")

  /// Có cho phép hoàn Credit (V1 = false, chỉ hoàn khi lỗi hệ thống).
  allowRefund Boolean @default(false) @map("allow_refund")

  createdAt DateTime @default(now()) @map("created_at")
  createdBy String?  @map("created_by") @db.Uuid
  updatedAt DateTime @updatedAt @map("updated_at")
  updatedBy String?  @map("updated_by") @db.Uuid

  @@map("billing_credit_policy")
  @@schema("billing")
}

/// Cấu hình hiển thị tiền tệ & hệ số quy đổi.
/// Theo yêu cầu: set giá bằng VND, hiển thị "VNĐ" sau số — không phụ thuộc tỉ giá.
model BillingCurrencyConfig {
  id          String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  scope       String  @unique @default("default")

  /// Mã tiền tệ lưu DB: luôn "VND" theo yêu cầu thị trường VN.
  currencyCode String @default("VND") @map("currency_code")
  /// Ký hiệu hiển thị trên UI (mặc định "VNĐ"; SuperAdmin có thể đổi "đ", "₫", "$"…).
  displaySymbol String @default("VNĐ") @map("display_symbol")
  /// Ký hiệu đặt TRƯỚC số (true) hay SAU số (false). true = $49, false = 1,225,000VNĐ.
  symbolBefore Boolean @default(false) @map("symbol_before")
  /// Có dùng dấu phân cách hàng nghìn (vd: 1,200,000).
  useThousandsSeparator Boolean @default(true) @map("use_thousands_separator")
  /// Ký tự phân cách hàng nghìn.
  thousandsSeparator String @default(",") @map("thousands_separator")
  /// Số chữ số thập phân (VND = 0).
  decimalDigits Int @default(0) @map("decimal_digits")

  /// Bật/tắt hiển thị giá gốc USD tham chiếu (chỉ để so sánh, không dùng thanh toán).
  showReferenceUsd Boolean @default(false) @map("show_reference_usd")
  /// Tỉ giá tham chiếu USD↔VND cố định do SuperAdmin đặt (chỉ hiển thị, KHÔNG tự cập nhật).
  referenceUsdRate BigInt? @map("reference_usd_rate")
  /// Hệ số nhân 1 USD = ? VND. Ví dụ 25000 = $1 = 25.000đ.
  /// Lưu BigInt (VND × 100) để tránh sai số. Ví dụ 25,000.00 VND = 2_500_000.
  usdToVndRateHundredths BigInt? @map("usd_to_vnd_rate_hundredths")

  createdAt DateTime @default(now()) @map("created_at")
  createdBy String?  @map("created_by") @db.Uuid
  updatedAt DateTime @updatedAt @map("updated_at")
  updatedBy String?  @map("updated_by") @db.Uuid

  @@map("billing_currency_config")
  @@schema("billing")
}

/// Nội dung marketing / SEO trang /bang-gia (không gồm giá-quota — đó là các bảng plan).
/// Single-row scope="default". SuperAdmin chỉnh từ /admin/billing/page.
model BillingPageContent {
  id    String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  scope String @unique @default("default")

  /// SEO
  seoTitle                 String  @default("Bảng giá dịch vụ — inlink") @map("seo_title")
  seoDescription           String  @default("Bảng giá minh bạch cho nhà tuyển dụng: gói Tin đăng, Săn nhân sự và Top-up Credit. Không auto-charge, không phát sinh.") @map("seo_description")
  seoTitleRecruiter        String  @default("Bảng giá dành cho nhà tuyển dụng — inlink Recruiter") @map("seo_title_recruiter")
  seoDescriptionRecruiter  String  @default("Gói Tin đăng, Tin đăng Plus, Doanh nghiệp, Enterprise. Dịch vụ Săn nhân sự. Top-up Credit. Minh bạch, không auto-charge.") @map("seo_description_recruiter")
  focusKeyword             String? @map("focus_keyword")
