// =========================================================================
// RECRUITMENT DOMAIN
// =========================================================================

model Job {
  id             String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code           String  @unique
  tenantId       String  @map("tenant_id")
  companyId      String  @map("company_id") @db.Uuid
  title          String
  /// URL công khai: /jobs/{slug}. Trùng tiêu đề thì slug-1, slug-2…
  slug           String? @unique
  description    String
  requirements   String?
  benefits       String?
  industry       String?
  subIndustry    String? @map("sub_industry")
  department     String?
  jobLevel       String? @map("job_level")
  employmentType String? @map("employment_type")
  location       String?
  headcount      Int?    @default(1)
  deadline       DateTime? @db.Date
  experienceBand String? @map("experience_band")
  salaryMin      Int?    @map("salary_min")
  salaryMax      Int?    @map("salary_max")
  // sales | technical — loc track khi JD Sales khong con field cap bac.
  jobTrack       String? @map("job_track")
  // 22 truong matching Sales B2B (nhom B/C + nganh da chon).
  salesCriteria  Json?   @map("sales_criteria")
  // 23 truong matching Ky thuat (nhom B/C + nganh da chon).
  technicalCriteria Json? @map("technical_criteria")
  status         String  @default("draft")
  // Kiểm duyệt 2 lớp (bộ lọc tĩnh + Gemini). Tin chỉ public khi được duyệt.
  // 'draft' = chưa gửi duyệt; 'pending' = đang trong hàng đợi kiểm duyệt.
  moderationStatus  String    @default("draft") @map("moderation_status")
  aiRiskScore       Int?      @map("ai_risk_score")
  aiReason          String?   @map("ai_reason")
  aiIsB2b           Boolean?  @map("ai_is_b2b")
  aiSuggestedAction String?   @map("ai_suggested_action")
  moderationNote    String?   @map("moderation_note")
  moderatedAt       DateTime? @map("moderated_at")
  moderatedBy       String?   @map("moderated_by") @db.Uuid
  // Embedding cá»§a mÃ´ táº£ cÃ´ng viá»‡c (JD) cho AI Matching, ghi/Ä‘á»c qua raw SQL.
  embedding      Unsupported("vector(768)")?
  publishedAt    DateTime? @map("published_at")

  createdAt DateTime  @default(now()) @map("created_at")
  createdBy String?   @map("created_by") @db.Uuid
  updatedAt DateTime  @updatedAt @map("updated_at")
  updatedBy String?   @map("updated_by") @db.Uuid
  deletedAt DateTime? @map("deleted_at")
  deletedBy String?   @map("deleted_by") @db.Uuid
  isDeleted Boolean   @default(false) @map("is_deleted")
  version   Int       @default(1)

  company      Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  skills       JobSkill[]
  applications Application[]
  interviews   Interview[]
  offers       Offer[]
  onboardings  Onboarding[]
  bookmarks    JobBookmark[]

  @@index([tenantId, status])
  @@index([companyId])
  @@index([jobTrack])
  @@index([moderationStatus])
  @@map("job")
  @@schema("recruitment")
}

/// Tin tuyá»ƒn dá»¥ng á»©ng viÃªn Ä‘Ã£ lÆ°u (bookmark).
model JobBookmark {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
