/// Audit log cho mọi thay đổi cấu hình billing (compliance + debug).
model BillingAuditLog {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// Loại entity bị thay đổi: "platform_plan" | "sourcing_plan" | "credit_topup" | "credit_policy" | "currency_config".
  entity    String
  /// Mã entity (vd: "TIN_DANG" hoặc "default").
  entityKey String   @map("entity_key")
  /// Hành động: "create" | "update" | "delete" | "activate" | "deactivate".
  action    String
  /// Diff JSON: { before: {...}, after: {...} } — chỉ lưu field thay đổi.
  diff      Json
  actorId   String?  @map("actor_id") @db.Uuid
  actorEmail String? @map("actor_email")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([entity, entityKey])
  @@index([createdAt])
  @@map("billing_audit_log")
  @@schema("billing")
}

/// Tài khoản Credit của mỗi công ty.
model BillingCreditAccount {
  id                 String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId           String    @map("tenant_id")
  companyId          String    @unique @map("company_id") @db.Uuid
  balance            Int       @default(0)
  lifetimeGranted    Int       @default(0) @map("lifetime_granted")
  lifetimeConsumed   Int       @default(0) @map("lifetime_consumed")
  lifetimeRefunded   Int       @default(0) @map("lifetime_refunded")
  lastActivityAt     DateTime? @map("last_activity_at")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  @@map("billing_credit_account")
  @@schema("billing")
}

/// Nhật ký mọi thao tác liên quan đến Credit (chỉ ghi log, chưa trừ thật ở bước này).
model BillingCreditTransaction {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String   @map("tenant_id")
  companyId    String   @map("company_id") @db.Uuid
  accountId    String   @map("account_id") @db.Uuid
  /// Loại giao dịch: deduct | grant | topup | refund | adjustment
  type         String
  /// Hành động: view_profile | reopen_profile | view_applicant | contact_potential | contact_applicant | view_match_summary | manual_grant | manual_adjust | plan_grant
  action       String
  /// Số credit thay đổi (âm cho trừ, dương cho cộng). Ở bước LOG-ONLY: luôn = -costPerXxx hoặc +delta.
  creditDelta  Int      @map("credit_delta")
  /// Số dư sau giao dịch. Ở bước LOG-ONLY: balance hiện tại (chưa trừ).
  balanceAfter Int      @map("balance_after")
  /// Cost per unit tại thời điểm giao dịch (từ policy snapshot).
  costPerUnit  Int      @map("cost_per_unit")
  quantity     Int      @default(1)
  candidateId  String?  @map("candidate_id") @db.Uuid
  jobId        String?  @map("job_id") @db.Uuid
  connectionId String?  @map("connection_id") @db.Uuid
  actorUserId  String?  @map("actor_user_id") @db.Uuid
  actorEmail   String?  @map("actor_email")
  /// Snapshot quy tắc trừ tại thời điểm giao dịch.
  policySnapshot Json?  @map("policy_snapshot")
  note         String?
  /// Metadata bổ sung (JSON).
  metadata     Json?    @default("{}")
  /// enforced=false ở bước LOG-ONLY. Sau này bật: true = thực sự trừ balance.
  enforced     Boolean  @default(false)
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([companyId, createdAt])
  @@index([type, action])
  @@index([candidateId])
  @@index([createdAt])
  @@map("billing_credit_transaction")
  @@schema("billing")
}

/// Cấu hình thanh toán Top-up (Bước 7). Single-row scope="default".
/// Mode 'mock' = giả lập, 'live' = Stripe thật (sandbox hoặc production).
/// Stripe keys được mã hoá AES-256-GCM trước khi lưu (giống AiSetting).
model BillingPaymentSetting {
  id                    String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  scope                 String   @unique @default("default")

  /// 'mock' | 'live'
  mode                  String   @default("mock")

  /// Stripe publishable key (pk_test_xxx / pk_live_xxx) — encrypted.
  stripePublishableKeyEnc String? @map("stripe_publishable_key_enc")
  /// Stripe secret key (sk_test_xxx / sk_live_xxx) — encrypted. KHÔNG trả ra API.
  stripeSecretKeyEnc    String?  @map("stripe_secret_key_enc")
  /// Stripe webhook signing secret (whsec_xxx) — encrypted.
  stripeWebhookSecretEnc String? @map("stripe_webhook_secret_enc")

  /// URL trả về sau khi thanh toán. {CHECKOUT_SESSION_ID} sẽ được replace.
  successUrl            String   @default("/recruiter/billing/topup/success?session={CHECKOUT_SESSION_ID}") @map("success_url")
  cancelUrl             String   @default("/recruiter/billing/topup/cancel") @map("cancel_url")

  createdAt             DateTime @default(now()) @map("created_at")
  createdBy             String?  @map("created_by") @db.Uuid
  updatedAt             DateTime @updatedAt @map("updated_at")
  updatedBy             String?  @map("updated_by") @db.Uuid

  @@map("billing_payment_setting")
  @@schema("billing")
}

/// Đơn mua Top-up Credit (Bước 7). Lifecycle: pending → paid | failed → refunded.
model BillingOrder {
  id                       String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId                 String   @map("tenant_id")
  companyId                String   @map("company_id") @db.Uuid

  /// 'topup' | 'platform' | 'sourcing'
  kind                     String   @default("topup")
  /// Snapshot từ billing_credit_topup tại thời điểm mua (không thay đổi sau).
  topupId                  String?  @map("topup_id") @db.Uuid
  creditCountSnapshot      Int      @default(0) @map("credit_count_snapshot")
  priceVndSnapshot         BigInt   @map("price_vnd_snapshot")
  /// Snapshot mã/tên gói tin hoặc gói Săn.
  planCode                 String?  @map("plan_code")
  planName                 String?  @map("plan_name")

  /// 'pending' | 'paid' | 'failed' | 'refunded'
  status                   String   @default("pending")

  /// 'stripe' | 'stripe-mock'
  provider                 String   @default("stripe")
  providerSessionId        String?  @map("provider_session_id")
  providerPaymentIntent    String?  @map("provider_payment_intent")

  createdByUserId          String   @map("created_by_user_id") @db.Uuid
  createdByEmail           String?  @map("created_by_email")

  createdAt                DateTime @default(now()) @map("created_at")
  paidAt                   DateTime? @map("paid_at")
  failedAt                 DateTime? @map("failed_at")
  refundedAt               DateTime? @map("refunded_at")

  note                     String?
  metadata                 Json     @default("{}")

  payments                 BillingPayment[]
  commissionEntry          CrmCommissionEntry?
  orderInvoice             CrmOrderInvoice?
  paidActivity             CrmActivity?

  @@index([companyId, createdAt])
  @@index([status])
  @@index([provider, providerSessionId])
  @@map("billing_order")
  @@schema("billing")
}

/// Log mỗi webhook event từ payment provider (Bước 7). Audit + debug.
model BillingPayment {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId           String   @map("order_id") @db.Uuid

  /// Stripe event ID (evt_xxx). Unique để idempotent xử lý.
  providerEventId   String?  @unique @map("provider_event_id")

  /// 'checkout.session.completed' | 'payment_intent.succeeded' | 'payment_intent.payment_failed' | v.v.
  eventType         String   @map("event_type")

  /// 'received' | 'processed' | 'failed' | 'ignored'
  status            String   @default("received")

  /// Số tiền VND (snapshot từ event) — null nếu event không kèm amount.
  amountVnd         BigInt?  @map("amount_vnd")

  /// Toàn bộ payload từ provider.
  rawPayload        Json     @default("{}") @map("raw_payload")

  errorMessage      String?  @map("error_message")

  createdAt         DateTime @default(now()) @map("created_at")

  order             BillingOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
  @@index([eventType])
  @@map("billing_payment")
  @@schema("billing")
}

// =========================================================================
// CRM — lead và phễu bán gói. Không gán gói, không cộng Credit.
// Gán gói chỉ đi từ đơn billing đã thanh toán hoặc SuperAdmin.
// =========================================================================

model CrmPipeline {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code        String   @unique
  name        String
  description String?
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")

  stages CrmStage[]
  deals  CrmDeal[]

  @@map("crm_pipeline")
  @@schema("crm")
}

model CrmStage {
  id             String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  pipelineId     String @map("pipeline_id") @db.Uuid
  code           String
  name           String
  sortOrder      Int    @default(1) @map("sort_order")
  winProbability Int    @default(10) @map("win_probability")

  pipeline CrmPipeline @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  deals    CrmDeal[]

  @@unique([pipelineId, code])
  @@map("crm_stage")
  @@schema("crm")
}

model CrmPartner {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name            String
  phone           String   @unique
  code            String   @unique
  /// Tài khoản NTD tự đăng ký. Null nếu CRM tạo hộ. Mỗi tài khoản một mã.
  userId          String?  @unique @map("user_id") @db.Uuid
  createdByUserId String   @map("created_by_user_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

