// Prisma schema cho IndustrialLink.
// Multi-schema theo Business Domain. Má»i entity káº¿ thá»«a nhÃ³m trÆ°á»ng Base
// (created/updated/deleted + version + soft delete + tenant) theo chuáº©n ChÆ°Æ¡ng 4.4.1.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["identity", "candidate", "knowledge", "shared", "company", "recruitment", "cms", "billing", "crm"]
}

// =========================================================================
// SHARED
// =========================================================================

/// Bá»™ Ä‘áº¿m dÃ¹ng Ä‘á»ƒ sinh Business Code dáº¡ng CAN-2026-000001.
model Sequence {
  key   String @id
  value BigInt @default(0)

  @@map("sequence")
  @@schema("shared")
}

/// Cấu hình AI Gateway chỉnh runtime qua /admin/ai-settings (SuperAdmin).
/// Bản ghi đơn (scope="default"). API key được mã hoá AES-256-GCM trước khi lưu.
/// Giá trị ở đây (nếu có) ưu tiên hơn biến môi trường.
model AiSetting {
  id                   String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  scope                String  @unique @default("default")
  provider             String?
  embeddingDim         Int?    @map("embedding_dim")
  openaiApiKeyEnc      String? @map("openai_api_key_enc")
  openaiModel          String? @map("openai_model")
  openaiEmbeddingModel String? @map("openai_embedding_model")
  anthropicApiKeyEnc   String? @map("anthropic_api_key_enc")
  anthropicModel       String? @map("anthropic_model")
  geminiApiKeyEnc      String? @map("gemini_api_key_enc")
  geminiModel          String? @map("gemini_model")
  geminiEmbeddingModel String? @map("gemini_embedding_model")
  /// Khóa Gemini chỉ cho quét SEO bài viết (thực thể + tỷ lệ chữ). Không dùng cho JD/CV.
  seoGeminiApiKeyEnc   String? @map("seo_gemini_api_key_enc")
  seoGeminiModel       String? @map("seo_gemini_model")
  /// Khóa Google PageSpeed Insights cho trang Core Web Vitals.
  pagespeedApiKeyEnc   String? @map("pagespeed_api_key_enc")
  pagespeedSiteUrl     String? @map("pagespeed_site_url") @db.VarChar(200)
  pagespeedAutoScan    Boolean @default(true) @map("pagespeed_auto_scan")
  /// JSON service account cho Google Indexing API (đè GOOGLE_INDEXING_CREDENTIALS_JSON).
  indexingCredentialsEnc String? @map("indexing_credentials_enc")
  indexingAutoNotify     Boolean @default(true) @map("indexing_auto_notify")

  updatedBy String?  @map("updated_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("ai_setting")
  @@schema("shared")
}

/// Lượt xem trang (first-party). IP chỉ trả về SuperAdmin khi xem chi tiết phiên.
model AnalyticsHit {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  visitorId String   @map("visitor_id") @db.VarChar(64)
  sessionId String   @map("session_id") @db.VarChar(64)
  path      String   @db.VarChar(500)
  title     String?  @db.VarChar(300)
  referrer  String?  @db.VarChar(500)
  source    String   @default("Trực tiếp") @db.VarChar(200)
  ip        String?  @db.VarChar(64)
  userAgent String?  @map("user_agent") @db.VarChar(400)
  device     String   @default("desktop") @db.VarChar(16)
  /// Thời gian ở lại trang, mili giây. 0 = chưa đo (khách rời trước khi beacon gửi).
  durationMs Int      @default(0) @map("duration_ms")
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([createdAt])
  @@index([sessionId, createdAt])
  @@index([visitorId, createdAt])
  @@map("analytics_hit")
  @@schema("shared")
}

/// Mỗi lần gọi Google Indexing API (URL_UPDATED / URL_DELETED).
model IndexingNotification {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  url        String   @db.VarChar(600)
  type       String   @db.VarChar(20)
  statusCode Int?     @map("status_code")
  ok         Boolean  @default(false)
  error      String?  @db.VarChar(300)
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([createdAt])
  @@map("indexing_notification")
  @@schema("shared")
}

/// Core Web Vitals đo trên trình duyệt khách (LCP, INP, CLS, FCP, TTFB).
model WebVitalSample {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  metricId  String   @unique @map("metric_id") @db.VarChar(100)
  path      String   @db.VarChar(500)
  name      String   @db.VarChar(8)
  value     Float
  device    String   @default("desktop") @db.VarChar(16)
  createdAt DateTime @default(now()) @map("created_at")

  @@index([createdAt])
  @@index([path, name, createdAt])
  @@map("web_vital_sample")
  @@schema("shared")
}

/// Một lần gọi PageSpeed Insights cho một URL.
model CwvScan {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  path         String   @db.VarChar(500)
  url          String   @db.VarChar(700)
  strategy     String   @db.VarChar(10)
  performance  Int?
  cruxUrl      Boolean  @default(false) @map("crux_url")
  fieldLcpMs   Int?     @map("field_lcp_ms")
  fieldInpMs   Int?     @map("field_inp_ms")
  fieldCls     Float?   @map("field_cls")
  originLcpMs  Int?     @map("origin_lcp_ms")
  originInpMs  Int?     @map("origin_inp_ms")
  originCls    Float?   @map("origin_cls")
  labLcpMs     Int?     @map("lab_lcp_ms")
  labTbtMs     Int?     @map("lab_tbt_ms")
  labCls       Float?   @map("lab_cls")
  labFcpMs     Int?     @map("lab_fcp_ms")
  labTtfbMs    Int?     @map("lab_ttfb_ms")
  error        String?  @db.VarChar(400)
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([path, strategy, createdAt])
  @@index([createdAt])
  @@map("cwv_scan")
  @@schema("shared")
}

/// ThÃ´ng bÃ¡o in-app (MVP). Email tháº­t Ä‘á»ƒ giai Ä‘oáº¡n sau.
model Notification {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId   String    @map("tenant_id")
  userId     String    @map("user_id") @db.Uuid
  type       String
  title      String
  body       String
  link       String?
  entityType String?   @map("entity_type")
  entityId   String?   @map("entity_id")
  readAt     DateTime? @map("read_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  @@index([userId, createdAt])
  @@index([userId, readAt])
  @@index([tenantId])
  @@map("notification")
  @@schema("shared")
}

// =========================================================================
// IDENTITY DOMAIN
// =========================================================================

model User {
  id           String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code         String  @unique
  tenantId     String  @map("tenant_id")
  email        String  @unique
  passwordHash String  @map("password_hash")
  displayName  String  @map("display_name")
  role         String
  status       String  @default("created")
  isVerified   Boolean @default(false) @map("is_verified")
  /// Báº­t MFA: sau khi nháº­p máº­t kháº©u Ä‘Ãºng pháº£i xÃ¡c thá»±c OTP email/TOTP má»›i cáº¥p JWT.
  mfaEnabled Boolean @default(false) @map("mfa_enabled")
  /// PhÆ°Æ¡ng thá»©c MFA Ä‘ang báº­t: "email_otp" | "totp". null náº¿u mfaEnabled=false.
  mfaMethod  String? @map("mfa_method")
  /// Secret TOTP Ä‘Ã£ xÃ¡c nháº­n (chá»‰ cÃ³ khi mfaMethod="totp").
  totpSecret String? @map("totp_secret")
  /// Secret TOTP táº¡m sinh ra khi setup, chá» xÃ¡c nháº­n báº±ng 1 mÃ£ Ä‘Ãºng.
  totpPendingSecret String? @map("totp_pending_secret")

  // Base fields
  createdAt DateTime  @default(now()) @map("created_at")
  createdBy String?   @map("created_by") @db.Uuid
  updatedAt DateTime  @updatedAt @map("updated_at")
  updatedBy String?   @map("updated_by") @db.Uuid
  deletedAt DateTime? @map("deleted_at")
  deletedBy String?   @map("deleted_by") @db.Uuid
  isDeleted Boolean   @default(false) @map("is_deleted")
  version   Int       @default(1)

  candidate              Candidate?
  otpCodes               OtpCode[]
  jobBookmarks           JobBookmark[]
  refreshTokens          RefreshToken[]
  companyMemberships     CompanyMember[]
  connectionRequests     CandidateConnection[] @relation("ConnectionRequester")
  shortlistSaves         CandidateShortlist[]  @relation("ShortlistSaver")

  @@index([tenantId])
  @@index([status])
  @@map("user")
  @@schema("identity")
}

/// MÃ£ OTP xÃ¡c thá»±c email khi Ä‘Äƒng kÃ½.
model OtpCode {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  code      String
  purpose   String    @default("register")
  expiresAt DateTime  @map("expires_at")
  consumedAt DateTime? @map("consumed_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("otp_code")
  @@schema("identity")
}

/// Refresh token (lÆ°u hash) phá»¥c vá»¥ xoay vÃ²ng token an toÃ n.
model RefreshToken {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")
  createdByIp String? @map("created_by_ip")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_token")
  @@schema("identity")
}

/// Nháº­t kÃ½ thay Ä‘á»•i dá»¯ liá»‡u (Audit Log) - phá»¥c vá»¥ compliance & truy váº¿t.
model AuditLog {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId      String   @map("tenant_id")
  actorId       String?  @map("actor_id") @db.Uuid
  action        String
  entityType    String   @map("entity_type")
  entityId      String?  @map("entity_id")
  before        Json?
  after         Json?
  ip            String?
  userAgent     String?  @map("user_agent")
  correlationId String?  @map("correlation_id")
  createdAt     DateTime @default(now()) @map("created_at")

  @@index([tenantId, entityType])
  @@index([actorId])
  @@map("audit_log")
  @@schema("identity")
}

// =========================================================================
// KNOWLEDGE DOMAIN (Taxonomy)
// =========================================================================

/// Ká»¹ nÄƒng chuáº©n hoÃ¡ (khÃ´ng lÆ°u text tá»± do). Ná»n táº£ng cho AI Matching.
model Skill {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code       String   @unique
  name       String
  slug       String   @unique
  category   String?
  parentId   String?  @map("parent_id") @db.Uuid
  aliases    String[] @default([])
  industry   String?
  difficulty String?
  demand     String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  parent   Skill?  @relation("SkillHierarchy", fields: [parentId], references: [id])
  children Skill[] @relation("SkillHierarchy")

  candidateSkills CandidateSkill[]
  jobSkills       JobSkill[]

  @@index([category])
  @@map("skill")
  @@schema("knowledge")
}

// =========================================================================
// CANDIDATE DOMAIN
// =========================================================================

model Candidate {
  id                String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code              String @unique
  tenantId          String @map("tenant_id")
  userId            String @unique @map("user_id") @db.Uuid
  displayName       String @map("display_name")
  status            String @default("registered")
  profileCompletion Int    @default(0) @map("profile_completion")
  /// áº¢nh Ä‘áº¡i diá»‡n táº£i lÃªn (Object Storage key). null â†’ frontend dÃ¹ng Gravatar/email.
  avatarStorageKey  String? @map("avatar_storage_key")
  avatarMime        String? @map("avatar_mime")

  createdAt DateTime  @default(now()) @map("created_at")
  createdBy String?   @map("created_by") @db.Uuid
  updatedAt DateTime  @updatedAt @map("updated_at")
  updatedBy String?   @map("updated_by") @db.Uuid
  deletedAt DateTime? @map("deleted_at")
  deletedBy String?   @map("deleted_by") @db.Uuid
  isDeleted Boolean   @default(false) @map("is_deleted")
  version   Int       @default(1)

  user         User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  profile      CandidateProfile?
  aiProfile    CandidateAiProfile?
  searchIndex  CandidateSearchIndex?
  resumes      CandidateResume[]
  skills       CandidateSkill[]
  experiences  CandidateExperience[]
  timeline     CandidateTimeline[]
  applications Application[]
  interviews   Interview[]
  offers       Offer[]
  onboardings  Onboarding[]
  connections  CandidateConnection[]
  shortlists   CandidateShortlist[]

  @@index([tenantId, status])
  @@map("candidate")
  @@schema("candidate")
}

model CandidateProfile {
  id                   String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  candidateId          String  @unique @map("candidate_id") @db.Uuid
  currentPosition      String? @map("current_position")
  jobLevel             String? @map("job_level")
  totalExperienceYears Float?  @map("total_experience_years")
  industry             String?
  /// Nhiá»u ngÃ nh Ä‘Ã£ lÃ m (bá»™ lá»c chÃ­nh Sales B2B).
  industriesExperienced String[] @default([]) @map("industries_experienced")
  specialization       String?
  summary              String?
  careerObjective      String? @map("career_objective")

  /// Sáº£n pháº©m / giáº£i phÃ¡p Ä‘Ã£ bÃ¡n.
  productsSold       String[] @default([]) @map("products_sold")
  /// Tá»‡p khÃ¡ch hÃ ng Ä‘Ã£ bÃ¡n.
  customerSegments   String[] @default([]) @map("customer_segments")
  /// Kinh nghiá»‡m Sales B2B (under_1 | 1_3 | 3_5 | 5_10 | 10_plus).
  b2bExperienceBand  String?  @map("b2b_experience_band")
  /// Khu vá»±c / thá»‹ trÆ°á»ng Ä‘Ã£ phá»¥ trÃ¡ch.
  marketsCovered     String[] @default([]) @map("markets_covered")

  /// ThÃ nh tÃ­ch & Ä‘Ã¡nh giÃ¡ nÃ¢ng cao.
  latestRevenue        Float?  @map("latest_revenue")
  kpiAchievementPct    Float?  @map("kpi_achievement_pct")
  salesHighlights      String? @map("sales_highlights")
  customerDevStyle     String? @map("customer_dev_style")
  newCustomerRatioPct  Float?  @map("new_customer_ratio_pct")
  dealType             String? @map("deal_type")
  typicalDealValue     Float?  @map("typical_deal_value")
  maxDealValue         Float?  @map("max_deal_value")
  sellingStages        String[] @default([]) @map("selling_stages")
  jobReadiness         String?  @map("job_readiness")
  availabilityBand     String?  @map("availability_band")
  noticePeriodDays     Int?    @map("notice_period_days")
  expectedSalaryMin    Int?    @map("expected_salary_min")
  expectedSalaryMax    Int?    @map("expected_salary_max")
  expectedOte          Int?    @map("expected_ote")
  languages            String[] @default([])
  /// Chi tiết nghe/nói/đọc/viết + đọc manual kỹ thuật theo từng ngôn ngữ (JSON).
  languageSkills       Json     @default("[]") @map("language_skills")
  hasB2License         Boolean? @map("has_b2_license")
  driverLicenseType    String?  @map("driver_license_type")
  willingToTravel      Boolean? @map("willing_to_travel")
  travelAbility        String?  @map("travel_ability")
  desiredPositions     String[] @default([]) @map("desired_positions")
  desiredLocations     String[] @default([]) @map("desired_locations")
  careerMotivations    String[] @default([]) @map("career_motivations")
  workStyles           String[] @default([]) @map("work_styles")
  careerOrientation    String?  @map("career_orientation")
  educationLevel       String?  @map("education_level")
  /// Xếp loại tốt nghiệp: Trung bình / Khá / Giỏi / Xuất sắc.
  educationClassification String? @map("education_classification")
  educationSchool      String?  @map("education_school")
  educationMajor       String?  @map("education_major")
  certificates         String[] @default([])
  /// Sở thích cá nhân (đọc sách, bóng đá...).
  hobbies              String[] @default([])
  birthYear            Int?     @map("birth_year")
  /// Ngày sinh đầy đủ nếu CV có (ISO YYYY-MM-DD hoặc DD/MM/YYYY).
  birthDate            String?  @map("birth_date")
  /// Tỉnh / Thành phố (34 đơn vị cấp tỉnh từ 01/7/2025).
  currentCity          String?  @map("current_city")
  /// Huyện (tuỳ chọn — cấp huyện không còn bắt buộc sau cải cách).
  district             String?
  /// Xã / Phường / Đặc khu (cấp xã mới từ 01/7/2025).
  ward                 String?
  phone                String?

  /// sales | technical — lĩnh vực hồ sơ / matching.
  jobTrack                 String?  @map("job_track")
  brandsTechnologies       String[] @default([]) @map("brands_technologies")
  technicalWorkTypes       String[] @default([]) @map("technical_work_types")
  technicalAutonomyLevel   Int?     @map("technical_autonomy_level")
  troubleshootingLevel     Int?     @map("troubleshooting_level")
  technicalTools           String[] @default([]) @map("technical_tools")
  documentLiteracy         String[] @default([]) @map("document_literacy")
  systemScaleNote          String?  @map("system_scale_note")
  shiftFlexibility         String?  @map("shift_flexibility")
  desiredWorkEnvironments  String[] @default([]) @map("desired_work_environments")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  candidate Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  @@map("candidate_profile")
  @@schema("candidate")
}

/// Kinh nghiem theo tung cong ty (ma tran ho so Sales B2B).
model CandidateExperience {
  id          String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  candidateId String  @map("candidate_id") @db.Uuid
  sortOrder   Int     @default(0) @map("sort_order")

  companyName String  @map("company_name")
  jobTitle    String  @map("job_title")
  startYear   Int?    @map("start_year")
  endYear     Int?    @map("end_year")
  isCurrent   Boolean @default(false) @map("is_current")

  industries       String[] @default([])
  productsSold     String[] @default([]) @map("products_sold")
  customerSegments String[] @default([]) @map("customer_segments")
  marketsCovered   String[] @default([]) @map("markets_covered")
  sellingStages    String[] @default([]) @map("selling_stages")
  brandsTechnologies String[] @default([]) @map("brands_technologies")
  /// KT - muc tu chu 1-5 tai cong ty nay (matching tech.jd11 theo tung cong ty).
  technicalAutonomyLevel Int? @map("technical_autonomy_level")

  revenueBand          String? @map("revenue_band")
  latestRevenue        Float?  @map("latest_revenue")
  kpiBand              String? @map("kpi_band")
  kpiAchievementPct    Float?  @map("kpi_achievement_pct")
  newCustomerRatioBand String? @map("new_customer_ratio_band")
  newCustomerRatioPct  Float?  @map("new_customer_ratio_pct")
  dealType             String? @map("deal_type")
  typicalDealValueBand String? @map("typical_deal_value_band")
  typicalDealValue     Float?  @map("typical_deal_value")
  maxDealValue         Float?  @map("max_deal_value")
  maxDealRole          String? @map("max_deal_role")

  highlights     String?
  jobDescription String? @map("job_description")
  missingFields  String[] @default([]) @map("missing_fields")
  source         String   @default("manual")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  candidate Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  @@index([candidateId, sortOrder])
  @@map("candidate_experience")
  @@schema("candidate")
}

/// Metadata cá»§a file CV. File tháº­t lÆ°u á»Ÿ Object Storage (MinIO/S3).
model CandidateResume {
  id          String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  candidateId String  @map("candidate_id") @db.Uuid
  tenantId    String  @map("tenant_id")
  fileName    String  @map("file_name")
  storageKey  String  @map("storage_key")
  mime        String
  size        Int
  hash        String?
  parseStatus String  @default("pending") @map("parse_status")
  parseError  String? @map("parse_error")
  jobId       String? @map("job_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  candidate Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  @@index([candidateId])
  @@map("candidate_resume")
  @@schema("candidate")
}

model CandidateSkill {
  id                String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  candidateId       String  @map("candidate_id") @db.Uuid
  skillId           String? @map("skill_id") @db.Uuid
  name              String
  level             String  @default("intermediate")
  yearsOfExperience Float?  @map("years_of_experience")

  createdAt DateTime @default(now()) @map("created_at")

  candidate Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  skill     Skill?    @relation(fields: [skillId], references: [id])

  @@unique([candidateId, name])
  @@index([skillId])
  @@map("candidate_skill")
  @@schema("candidate")
}

/// Há»“ sÆ¡ AI cá»§a á»©ng viÃªn - do AI sinh, khÃ´ng pháº£i ngÆ°á»i dÃ¹ng nháº­p.
model CandidateAiProfile {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  candidateId    String   @unique @map("candidate_id") @db.Uuid
  summary        String?
  strengths      String[] @default([])
  weaknesses     String[] @default([])
  careerPath     String?  @map("career_path")
  aiScore        Float?   @map("ai_score")
  confidence     Float?
  // Vector embedding (pgvector). Ghi/Ä‘á»c qua raw SQL; Prisma bá» qua cá»™t nÃ y.
  embedding      Unsupported("vector(768)")?
  lastAnalyzedAt DateTime? @map("last_analyzed_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  candidate Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  @@map("candidate_ai_profile")
  @@schema("candidate")
}

